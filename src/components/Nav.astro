---
const navLinks = [
  { href: "#om", label: "Om KST" },
  { href: "#priser", label: "Priser" },
  { href: "#lokationer", label: "Find os" },
];
---

<nav id="navbar" class="fixed top-0 left-0 right-0 px-6 lg:px-16 py-6 flex justify-between items-center bg-cream/90 backdrop-blur-md z-50 transition-all duration-400">
  <a href="#" class="font-display text-2xl font-medium text-text tracking-wide no-underline">
    Klinik Aagaard
  </a>

  <ul class="hidden md:flex gap-10 list-none">
    {navLinks.map(link => (
      <li>
        <a
          href={link.href}
          class="text-sm text-text-light uppercase tracking-widest no-underline relative hover:text-text transition-colors duration-300 after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-px after:bg-sage-dark after:transition-[width] after:duration-300 hover:after:w-full"
        >
          {link.label}
        </a>
      </li>
    ))}
    <li>
      <a
        href="https://kst.onlinebooq.dk/"
        target="_blank"
        class="bg-sage text-white px-6 py-3 rounded-full text-sm uppercase tracking-widest no-underline hover:bg-sage-dark hover:-translate-y-0.5 transition-all duration-300"
      >
        Book tid
      </a>
    </li>
  </ul>

  <button id="mobile-menu-btn" class="md:hidden bg-transparent border-none cursor-pointer p-2">
    <span class="block w-6 h-0.5 bg-text my-1.5 transition-all duration-300"></span>
    <span class="block w-6 h-0.5 bg-text my-1.5 transition-all duration-300"></span>
    <span class="block w-6 h-0.5 bg-text my-1.5 transition-all duration-300"></span>
  </button>
</nav>

<!-- Mobile Menu -->
<div id="mobile-menu" class="hidden fixed top-20 left-0 right-0 bg-white shadow-lg z-40 p-8 md:hidden">
  <ul class="flex flex-col gap-6 list-none">
    {navLinks.map(link => (
      <li>
        <a
          href={link.href}
          class="text-sm text-text-light uppercase tracking-widest no-underline hover:text-text transition-colors duration-300"
        >
          {link.label}
        </a>
      </li>
    ))}
    <li>
      <a
        href="https://kst.onlinebooq.dk/"
        target="_blank"
        class="inline-block bg-sage text-white px-6 py-3 rounded-full text-sm uppercase tracking-widest no-underline hover:bg-sage-dark transition-all duration-300"
      >
        Book tid
      </a>
    </li>
  </ul>
</div>

<script>
  const navbar = document.getElementById('navbar');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  // Navbar scroll effect
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('py-4', 'shadow-md');
      navbar?.classList.remove('py-6');
    } else {
      navbar?.classList.remove('py-4', 'shadow-md');
      navbar?.classList.add('py-6');
    }
  });

  // Mobile menu toggle
  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Close mobile menu when clicking a link
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });
</script>
