---

---

<section class="py-24 lg:py-32 px-6 lg:px-16 bg-gradient-to-b from-cream to-white">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Image column -->
      <div class="relative order-2 lg:order-1">
        <div class="relative max-w-md mx-auto lg:mx-0">
          <!-- Decorative background shape -->
          <div class="absolute -top-6 -left-6 w-full h-full bg-sage/10 rounded-3xl -z-10"></div>

          <img
            src="https://klinikaagaard.dk/wp-content/uploads/2025/08/lisbeth-aagaard-225x300.webp"
            alt="Lisbeth Aagaard"
            class="w-full rounded-3xl shadow-[0_20px_60px_0_rgba(0,0,0,0.1)]"
          />

          <!-- Experience badge -->
          <div class="absolute -bottom-6 -right-6 lg:bottom-auto lg:-right-8 lg:top-1/2 lg:-translate-y-1/2">
            <div class="bg-white p-6 lg:p-8 rounded-2xl shadow-xl text-center">
              <strong class="block font-display text-4xl lg:text-5xl text-sage-dark">18+</strong>
              <span class="text-xs text-text-light uppercase tracking-widest mt-1 block">års erfaring</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Content column -->
      <div class="order-1 lg:order-2">
        <div class="text-xs tracking-[0.2em] uppercase text-sage-dark mb-4 flex items-center gap-4">
          <span class="w-8 h-px bg-sage-dark"></span>
          Om mig
        </div>

        <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-normal mb-8 leading-tight">
          Lisbeth Aagaard
        </h2>

        <div class="space-y-6 text-text-light text-lg leading-relaxed">
          <p>
            Med mere end 18 års erfaring inden for kraniosakral terapi hjælper jeg spædbørn, børn og voksne med at finde balance og velvære.
          </p>
          <p>
            Behandlingen påvirker centralnervesystemet fra kraniet ned gennem rygsøjlen til kors- og haleben, og kroppen bliver i stand til at helbrede sig selv.
          </p>
          <p>
            Behandlingen er behagelig, blid og smertefri.
          </p>
        </div>

        <!-- Credentials -->
        <div class="flex flex-col sm:flex-row gap-6 pt-10 mt-10 border-t border-sage/20">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-sage/15 rounded-full flex items-center justify-center text-sage-dark">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <div>
              <span class="block text-text font-medium">RAB-registreret</span>
              <span class="text-sm text-text-light">Registreret Alternativ Behandler</span>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-sage/15 rounded-full flex items-center justify-center text-sage-dark">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <div>
              <span class="block text-text font-medium">Eksamineret</span>
              <span class="text-sm text-text-light">Kraniosakral terapeut</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
