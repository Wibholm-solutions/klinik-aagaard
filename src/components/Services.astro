---
const services = [
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4z"/><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/></svg>`,
    title: "Spædbørn",
    description: "Behandling af kolik, uro, asymmetri og problemer opstået under fødslen. Behandlingen er meget blid og velegnet til de mindste."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5z"/><circle cx="12" cy="12" r="3"/></svg>`,
    title: "Børn & Unge",
    description: "Hjælp til koncentrationsbesvær, hovedpine, stress og de fysiske og psykiske udfordringer i teenageårene."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>`,
    title: "Stress & Angst",
    description: "Nedsæt stressniveauet og find tilbage til ro og balance i nervesystemet gennem nænsom behandling."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20z"/><path d="M12 6v6l4 2"/></svg>`,
    title: "Hovedpine & Migræne",
    description: "Lindring af kronisk hovedpine og migræne ved at løsne spændinger og skabe balance i kraniet."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M12 2v20M2 12h20"/><circle cx="12" cy="12" r="10"/></svg>`,
    title: "Ryg & Nakke",
    description: "Behandling af smerter, spændinger og hold i nakke og ryg samt eftervirkninger af piskesmæld."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
    title: "Gigt & Smerter",
    description: "Lindring af gigtsmerter og kroniske smertetilstande gennem afspænding og øget kropsbevidsthed."
  }
];
---

<section class="py-24 lg:py-32 px-6 lg:px-16 bg-white" id="om">
  <div class="max-w-6xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16 lg:mb-20">
      <div class="text-xs tracking-[0.2em] uppercase text-sage-dark mb-4 flex items-center justify-center gap-4">
        <span class="w-8 h-px bg-sage-dark"></span>
        Behandlingsområder
        <span class="w-8 h-px bg-sage-dark"></span>
      </div>
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-normal mb-6">
        Hvem kan have gavn af behandlingen?
      </h2>
      <p class="text-text-light text-lg">
        Kraniosakral terapi kan hjælpe med en bred vifte af fysiske og psykiske ubalancer
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {services.map(service => (
        <div class="group bg-cream p-8 lg:p-10 rounded-3xl shadow-[0_2px_10px_0_rgba(0,0,0,0.03)] hover:shadow-[0_15px_40px_0_rgba(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-2 relative overflow-hidden">
          <!-- Accent line on hover -->
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-sage to-sage-dark scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-500"></div>

          <div class="w-14 h-14 bg-sage/15 rounded-2xl flex items-center justify-center mb-6 text-sage-dark group-hover:bg-sage group-hover:text-white transition-all duration-300">
            <Fragment set:html={service.icon} />
          </div>

          <h3 class="font-display text-xl lg:text-2xl font-medium mb-4 text-text">
            {service.title}
          </h3>

          <p class="text-text-light leading-relaxed">
            {service.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
