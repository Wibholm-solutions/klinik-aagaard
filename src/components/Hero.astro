---

---

<section class="min-h-screen flex items-center justify-center px-6 lg:px-16 pt-28 pb-20 relative overflow-hidden">
  <!-- Elegant background gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-cream via-warm/30 to-cream -z-10"></div>

  <!-- Decorative circles -->
  <div class="absolute top-1/4 right-[10%] w-[400px] h-[400px] rounded-full border border-sage/20 animate-float opacity-60"></div>
  <div class="absolute bottom-1/4 left-[5%] w-[250px] h-[250px] rounded-full border border-sage/15 animate-float-reverse opacity-40"></div>
  <div class="absolute top-[15%] left-[15%] w-[150px] h-[150px] rounded-full bg-sage/5 animate-pulse-slow"></div>

  <div class="text-center max-w-4xl mx-auto animate-fade-in-up">
    <!-- Tagline -->
    <div class="text-sm tracking-[0.25em] uppercase text-sage-dark mb-8 flex items-center justify-center gap-4">
      <span class="w-12 h-px bg-sage-dark/50"></span>
      Kraniosakral Terapi
      <span class="w-12 h-px bg-sage-dark/50"></span>
    </div>

    <!-- Main heading -->
    <h1 class="font-display text-4xl md:text-5xl lg:text-7xl font-normal leading-[1.15] mb-8 text-text">
      Find <em class="italic text-sage-dark">balance</em><br class="hidden sm:block" />
      og ro i krop og sind
    </h1>

    <!-- Description -->
    <p class="text-lg lg:text-xl text-text-light mb-12 max-w-2xl mx-auto leading-relaxed">
      En nænsom behandlingsform der afspænder muskler, løsner for skævheder og nedsætter stressniveauet i din krop
    </p>

    <!-- CTA buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a
        href="https://kst.onlinebooq.dk/"
        target="_blank"
        class="group inline-flex items-center gap-3 px-10 py-5 rounded-full bg-sage text-white no-underline font-normal tracking-wide shadow-lg shadow-sage/20 hover:bg-sage-dark hover:-translate-y-1 hover:shadow-xl hover:shadow-sage/30 transition-all duration-300"
      >
        Book en tid
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a
        href="#om"
        class="inline-flex items-center gap-2 px-10 py-5 rounded-full bg-transparent text-text border border-text/30 no-underline font-normal tracking-wide hover:bg-text hover:text-cream hover:border-text transition-all duration-300"
      >
        Læs mere om behandlingen
      </a>
    </div>

    <!-- Trust indicators -->
    <div class="flex flex-wrap justify-center gap-8 mt-16 pt-12 border-t border-sage/20">
      <div class="flex items-center gap-2 text-text-light">
        <div class="w-8 h-8 rounded-full bg-sage/20 flex items-center justify-center text-sage-dark text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <span class="text-sm">RAB-registreret</span>
      </div>
      <div class="flex items-center gap-2 text-text-light">
        <div class="w-8 h-8 rounded-full bg-sage/20 flex items-center justify-center text-sage-dark text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <span class="text-sm">18+ års erfaring</span>
      </div>
      <div class="flex items-center gap-2 text-text-light">
        <div class="w-8 h-8 rounded-full bg-sage/20 flex items-center justify-center text-sage-dark text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <span class="text-sm">Roskilde & Ringsted</span>
      </div>
    </div>
  </div>
</section>
